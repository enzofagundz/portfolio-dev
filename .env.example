# Copie para .env e preencha. O .env não é versionado.
# Os valores são lidos em tempo de build (npm run generate),
# então mudanças exigem gerar o site de novo.

# WhatsApp publicado nos CTAs do site. Só dígitos, com DDI e DDD.
NUXT_PUBLIC_WHATSAPP_NUMBER=

# E-mail de contato exibido no site.
NUXT_PUBLIC_CONTACT_EMAIL=
